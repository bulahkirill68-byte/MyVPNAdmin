# HTTP bind is hardcoded to 127.0.0.1:8000 in compose.yaml.
POLL_SECONDS=15
PANEL_PUBLIC_IP=
COOKIE_SECURE=false
# Optional, set by scripts/enable_https.sh after getting a valid IP certificate:
# PUBLIC_ORIGIN=https://YOUR_PUBLIC_IP:8443
# Use the SSH tunnel with http://localhost:8000. Secure=true only with a real TLS reverse proxy.
